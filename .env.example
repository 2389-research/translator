# OpenAI API Key (required)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (optional, needed for Claude models)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default model (optional, defaults to gpt-6.1-sol)
# DEFAULT_MODEL=gpt-6.1-sol

# Output directory for translated files (optional)
# If not specified, files will be placed next to the original files
# OUTPUT_DIR=/path/to/output/directory

# Log level (optional, defaults to INFO)
# LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL